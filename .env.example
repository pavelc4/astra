PORT=3000
HOST=0.0.0.0

# Instagram cookies for GraphQL access (optional, fallback to snapsave)
# How to get:
#   1. Log in to Instagram in Chrome
#   2. Press F12 → Application → Cookies → instagram.com
#   3. Copy the "sessionid" and "csrftoken" values
#   4. Paste below (it will automatically URL decode/parse)
INSTAGRAM_COOKIES="sessionid=123456%3Aabc123%3A12; csrftoken=xxx"

# Facebook cookies for authenticated scraping (optional but required for
# private/group posts and multi-photo albums). Extract with cmd/cookie-dumper:
#   ./cookie-dumper -platform facebook -write-env
FACEBOOK_COOKIES="c_user=...; xs=...; datr=...; sb=..."

# Pixiv cookies for authenticated scraping & high-res artwork access. Extract with cmd/cookie-dumper:
#   ./cookie-dumper -platform pixiv -write-env
PIXIV_COOKIES="PHPSESSID=...; device_token=...; p_ab_id=0"
